  {q:"Which of the following is NEVER the correct move on a T.I.?", a:["Acknowledging their question before redirecting","Using emotionally charged adjectives in the verbal tour","Giving the full pricing breakdown to help them make an informed decision","Recapping the appointment after booking"], c:2}
];

let empName = '';
let qIndex = 0;
let score = 0;
let missed = [];

function startQuiz() {
  empName = document.getElementById('empNameInput').value.trim();
  if (!empName) { alert('Please enter your full name.'); return; }
  document.getElementById('namePanel').style.display = 'none';
  document.getElementById('quizActive').style.display = 'block';
  qIndex = 0; score = 0; missed = [];
  renderQuestion();
}

function renderQuestion() {
  const q = questions[qIndex];
  document.getElementById('qBar').style.width = ((qIndex / questions.length) * 100) + '%';
  document.getElementById('qCounter').textContent = `Question ${qIndex + 1} of ${questions.length}`;
  document.getElementById('qText').textContent = q.q;
  const opts = document.getElementById('qOptions');
  opts.innerHTML = '';
  q.a.forEach((opt, i) => {
    const btn = document.createElement('button');
    btn.className = 'q-opt';
    btn.textContent = opt;
    btn.onclick = () => handleAnswer(i);
    opts.appendChild(btn);
  });
}

function handleAnswer(idx) {
  const q = questions[qIndex];
  if (idx === q.c) { score++; }
  else { missed.push({q: q.q, a: q.a[q.c]}); }
  qIndex++;
  if (qIndex < questions.length) { renderQuestion(); }
  else { showResults(); }
}

function showResults() {
  const pct = Math.round((score / questions.length) * 100);
  document.getElementById('quizActive').style.display = 'none';
  const rp = document.getElementById('resultsPanel');
  rp.style.display = 'block';
  const scoreEl = document.getElementById('resultScore');
  scoreEl.textContent = pct + '%';
  scoreEl.className = 'result-score ' + (pct >= 80 ? 'result-pass' : 'result-fail');
  document.getElementById('resultLabel').textContent = pct >= 80 ? 'Certification Passed — Module 01: The T.I.' : 'Retake Required — Review Missed Questions Below';

  let missedHtml = '';
  if (missed.length) {
    missedHtml = `<div class="missed-label">Knowledge Gaps — Review These</div>`;
    missed.forEach(m => {
      missedHtml += `<div class="missed-item"><div class="missed-q">${m.q}</div><div class="missed-a">Correct Answer: ${m.a}</div></div>`;
    });
  }
  document.getElementById('missedSection').innerHTML = missedHtml;

  document.getElementById('formEmployee').value = empName;
  document.getElementById('formTopic').value = 'Module 01 - The T.I.';
  document.getElementById('formResult').value = pct;
  document.getElementById('certForm').submit();
}

function resetModule() {
  document.getElementById('resultsPanel').style.display = 'none';
  document.getElementById('quizActive').style.display = 'none';
  document.getElementById('namePanel').style.display = 'block';
  document.getElementById('empNameInput').value = '';
  window.scrollTo({top:0, behavior:'smooth'});
}
</script>
